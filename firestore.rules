rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Health check & test connection
    match /_connection_test/{id} {
      allow read, write: if isSignedIn();
    }

    // Users
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);
    }

    // Sessions
    match /sessions/{sessionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(sessionId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(sessionId) && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(sessionId) && resource.data.userId == request.auth.uid;
    }

    // Goals
    match /goals/{goalId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(goalId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(goalId) && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(goalId) && resource.data.userId == request.auth.uid;
    }

    // Study Rooms
    match /study_rooms/{roomId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(roomId) && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(roomId);
      allow delete: if isSignedIn() && isValidId(roomId) && resource.data.hostId == request.auth.uid;

      match /messages/{messageId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(messageId) && request.resource.data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() && isValidId(messageId) && resource.data.userId == request.auth.uid;
      }
    }

    // Collaborative Docs
    match /collaborative_docs/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(docId) && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(docId);
      allow delete: if isSignedIn() && isValidId(docId) && resource.data.ownerId == request.auth.uid;
    }

    // Partnerships
    match /partnerships/{partnerId} {
      allow get, list, create, update, delete: if isSignedIn() && isValidId(partnerId);
    }
  }
}
